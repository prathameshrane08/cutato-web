# Copy to .env.local (development) or set in your hosting provider (production).

# Public site URL, used for SEO metadata, email links and Stripe redirects.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin access. Comma-separated emails allowed to use /admin (checked on the server).
ADMIN_EMAILS=
# Shown on the admin login screen; keep in sync with ADMIN_EMAILS.
NEXT_PUBLIC_ADMIN_EMAIL=

# Email (Resend). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Cutato <bookings@your-domain.com>"
# Inbox that receives new salon/barber applications.
CUTATO_ADMIN_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI (AI chat, hairstyle advisor, voice transcription)
OPENAI_API_KEY=
